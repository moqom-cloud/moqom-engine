     sendmsg_einval: AtomicBool,
+
+    /// The differentiated services codepoint the caller set on the socket, if any.
+    ///
+    /// Read once at construction, because it is a property of the socket rather than of a
+    /// packet. Every send pushes an `IP_TOS` control message carrying the ECN codepoint, and a
+    /// control message sets the whole byte — so without this, a socket configured with
+    /// `IP_TOS`/`IPV6_TCLASS` has its codepoint silently replaced by zero on every datagram, and
+    /// the option appears to be accepted while having no effect on the wire.
+    dscp: u8,
+}
+
+/// The DSCP bits currently set on a socket, or zero if they cannot be read.
+///
+/// Failure is not an error worth propagating: the codepoint is an optimisation, the platform may
+/// not support reading it back, and a socket that cannot report one behaves as it does today.
+fn configured_dscp(io: &SockRef<'_>, is_ipv4: bool) -> u8 {
+    let (level, name) = if is_ipv4 {
+        (libc::IPPROTO_IP, libc::IP_TOS)
+    } else {
+        (libc::IPPROTO_IPV6, libc::IPV6_TCLASS)
+    };
+
+    let mut value: libc::c_int = 0;
+    let mut len = mem::size_of::<libc::c_int>() as libc::socklen_t;
+    // SAFETY: `value` and `len` outlive the call, and `len` describes `value` exactly.
+    let rc = unsafe {
+        libc::getsockopt(
+            io.as_raw_fd(),
+            level,
+            name,
+            (&raw mut value).cast::<libc::c_void>(),
+            &raw mut len,
+        )
+    };
+    if rc != 0 {
+        return 0;
+    }
+
+    // The low two bits are ECN's and belong to the transport, not to the caller.
+    (value as u8) & !0b11
 }
 
